{
  "manifest_version": 3,
  "name": "QiuYaTools 任务标签组",
  "version": "0.1.1",
  "description": "为 QiuYaTools 当前操作的浏览器标签显示任务分组；仅连接本机 Harness。",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://127.0.0.1:47931/*"
  ],
  "action": {
    "default_title": "QiuYaTools · 可选任务标签组",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
