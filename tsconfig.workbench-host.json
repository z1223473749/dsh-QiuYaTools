{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "files": [
    "src/features/workbench/integration.ts",
    "tests/types/computer-routing-sdk.ts",
    "tests/types/workbench-host-sdk.ts",
    "tests/types/workbench-tools-sdk.ts",
    "tests/types/acceptance-runs-sdk.ts"
  ]
}
