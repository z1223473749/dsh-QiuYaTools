{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "src/features/annotations/**/*.ts",
    "src/features/annotations/**/*.tsx",
    "tests/types/annotations-sdk.ts"
  ]
}
